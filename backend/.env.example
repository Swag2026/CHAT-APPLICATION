# PostgreSQL connection string (jaisa tumhare doosre projects me hai)
DATABASE_URL=postgresql://user:password@host:5432/chatdb

# Koi bhi random secret string - JWT token sign karne ke liye
JWT_SECRET=badlo-isko-kisi-lambe-random-string-se

# Signup ke waqt ye code batana zaroori hai - taaki koi bhi random insaan APK
# download karke signup na kar sake. Ye khud koi random string bana lo aur
# sirf apne trusted logon ko batao. Agar ye khaali/unset rakha, to koi bhi
# bina code ke signup kar sakta hai (purana, unsafe behavior).
SIGNUP_ACCESS_CODE=badlo-isko-apne-family-invite-code-se
